/-
  CryptidSolve.CliffordBridge
  ===========================
  Exact Projective & Exterior Clifford Algebra Theory of Dimensional Lifts,
  Reflections, and Transitional Bridges Across BB(6) Cryptids.

  Built with zero external dependencies (Lean 4 Core `Init` + `omega` + `decide`),
  maintaining strict mathematical rigor (all identities proved unconditionally over
  `Int` and `Nat`, with zero continuum approximations):

    1. Exact Integer Clifford Algebra `Cl(2, 0)` (`Cl20`):
       - Fundamental geometric product split `α X = (α ⌟ X) + (α ∧ X)` separating
         Grade-0 slow/conserved Lyapunov contraction from Grade-2 transverse planes.
       - Canonical `ℤ₂` grade involution (`Cl⁺ ⊕ Cl⁻`) and Cartan–Dieudonné sandwich
         reflection `-n X n` across the diagonal halting hyperplane `x₁ = x₂`.

    2. `Pin(2)` Reflection Origin of `D_ret = 2` Stage-3b Cones (`A.3`, `A.8`, `A.9`, `BMO 1`):
       - Proves that `A.3`, `A.8`, and `A.9` are generated by a SINGLE Stage-3a
         conserved shuttle operator `M₀` (`det(M₀ - I) = 0`) composed with the
         Clifford wall reflection `reflectWall (x₁, x₂) = (x₂, x₁)`, and that Stage 3b's
         `(1, 1)` Lyapunov vector is the `ℤ₂`-symmetrized invariant `α₀ + (-n α₀ n)`.

    3. Projective Geometric Algebra `PGA(1) = Cl(1, 0, 1)` & Grade-2 Ghost Eigenblades:
       - Proves the universal denominator-free Ghost Eigenblade Theorem: for ANY affine
         fast loop `D * u' = A * u + B`, wedging `X = u e₁ + e₀` with the homogeneous
         ghost 1-vector `G = B e₁ + (D - A) e₀` satisfies `D • (X' ∧ G) = A • (X ∧ G)`.
       - Evaluates Antihydra's exact Grade-2 bridge bivectors `G_{-1} ∧ G_0` and
         `G_{-1} ∧ G_relay` (`2^6` ultrametric factor).

    4. Inter-Dimensional Covector Intertwining & `ℤ₂` Sheet Bridges on Actual Cryptids:
       - `AppC_1` (`2D B → 3D E2 → 2D E1 → 2D B`): `+2` lift jump, exact `0`-loss `3D → 2D`
         and Even-`z` `2D → 2D` bridges, and `X_A + 2 = 2 * (X_B + 2)` ghost handoff law.
       - `T3.14` (`1D Pure ↔ 2D AB ↔ 2D×ℤ₂ LC/LE`): state-independent `+1` `LC/LE → AB`
         intertwining jump and the `ℤ₂` Grade-Flip Lock Theorem (`ΔE = 0 ↔ sheet flips`).
       - `T3.12` (`R → C` exact `0`-loss handoff), `A.5` (`D → C` `+1` handoff), and
         `A.1` (`b * c = 0` Plücker bivector annihilation & `+2` 3-blade swap bridge).
-/

import CryptidSolve.Stage3Aperiodic
import CryptidSolve.Stage4GhostAndPortals
import CryptidSolve.CryptidA11
import CryptidSolve.FrontierHoldouts

namespace CryptidSolve

/-! ## 1. Exact Integer Clifford Algebra `Cl(2, 0)` -/

/-- Multivector `s + x1 * e₁ + x2 * e₂ + b12 * (e₁ ∧ e₂)` in `Cl(2, 0)` over `Int`,
    where `e₁² = +1`, `e₂² = +1`, and `e₁ e₂ = -e₂ e₁ = e₁ ∧ e₂`. -/
structure Cl20 where
  s : Int
  x1 : Int
  x2 : Int
  b12 : Int
  deriving DecidableEq, Repr

namespace Cl20

def zero : Cl20 := ⟨0, 0, 0, 0⟩

def scalar (c : Int) : Cl20 := ⟨c, 0, 0, 0⟩

def vec (x1 x2 : Int) : Cl20 := ⟨0, x1, x2, 0⟩

def bivec (b : Int) : Cl20 := ⟨0, 0, 0, b⟩

def add (a b : Cl20) : Cl20 :=
  ⟨a.s + b.s, a.x1 + b.x1, a.x2 + b.x2, a.b12 + b.b12⟩

def smul (k : Int) (a : Cl20) : Cl20 :=
  ⟨k * a.s, k * a.x1, k * a.x2, k * a.b12⟩

/-- Exact Clifford geometric product in `Cl(2, 0)`. -/
def mul (a b : Cl20) : Cl20 :=
  ⟨a.s * b.s + a.x1 * b.x1 + a.x2 * b.x2 - a.b12 * b.b12,
   a.s * b.x1 + a.x1 * b.s - a.x2 * b.b12 + a.b12 * b.x2,
   a.s * b.x2 + a.x1 * b.b12 + a.x2 * b.s - a.b12 * b.x1,
   a.s * b.b12 + a.x1 * b.x2 - a.x2 * b.x1 + a.b12 * b.s⟩

/-- Canonical `ℤ₂` grade involution `x ↦ x̂` (`+1` on `Cl⁺`, `-1` on `Cl⁻`). -/
def gradeInvol (a : Cl20) : Cl20 :=
  ⟨a.s, -a.x1, -a.x2, a.b12⟩

/-- Grade-0 interior contraction `α ⌟ X` of two 1-vectors. -/
def contractVec (a1 a2 x1 x2 : Int) : Cl20 :=
  scalar (a1 * x1 + a2 * x2)

/-- Grade-2 exterior wedge product `α ∧ X` of two 1-vectors. -/
def wedgeVec (a1 a2 x1 x2 : Int) : Cl20 :=
  bivec (a1 * x2 - a2 * x1)

/-- Unnormalized Cartan–Dieudonné sandwich reflection `-n X n`. -/
def negSandwich (n x : Cl20) : Cl20 :=
  smul (-1) ((n.mul x).mul n)

end Cl20

/-- Unnormalized normal 1-vector `ñ = e₁ - e₂` (`ñ² = 2`) to the halting wall `x₁ = x₂`. -/
def wallNormal : Cl20 := Cl20.vec 1 (-1)

/-- Exact coordinate reflection across the diagonal halting hyperplane `x₁ = x₂`. -/
def reflectWall (p : Int × Int) : Int × Int := (p.2, p.1)

/-- Fundamental Clifford Split `α X = (α ⌟ X) + (α ∧ X)` on 1-vectors:
    separates Grade-0 Lyapunov energy contraction from the Grade-2 transverse plane. -/
theorem cl20_fundamental_split (a1 a2 x1 x2 : Int) :
    (Cl20.vec a1 a2).mul (Cl20.vec x1 x2) =
      (Cl20.contractVec a1 a2 x1 x2).add (Cl20.wedgeVec a1 a2 x1 x2) := by
  unfold Cl20.vec Cl20.mul Cl20.contractVec Cl20.wedgeVec Cl20.scalar Cl20.bivec Cl20.add
  simp only [Cl20.mk.injEq, Int.zero_mul, Int.mul_zero]
  refine ⟨by omega, by omega, by omega, by omega⟩

/-- Canonical `ℤ₂` grade involution is strictly involutive (`x̂̂ = x`), fixing `Cl⁺` and negating `Cl⁻`. -/
theorem cl20_gradeInvol_involutive (m : Cl20) :
    Cl20.gradeInvol (Cl20.gradeInvol m) = m := by
  cases m with
  | mk s x1 x2 b12 =>
    unfold Cl20.gradeInvol
    simp only [Cl20.mk.injEq]
    refine ⟨trivial, by omega, by omega, trivial⟩

/-- Square of `ñ = e₁ - e₂` in `Cl(2, 0)` equals the positive scalar `2`, and the
    Cartan–Dieudonné sandwich `-ñ X ñ` equals `2 • (x₂ e₁ + x₁ e₂)` identically. -/
theorem cl20_cartan_dieudonne_swap (x1 x2 : Int) :
    wallNormal.mul wallNormal = Cl20.scalar 2 ∧
      Cl20.negSandwich wallNormal (Cl20.vec x1 x2) = Cl20.smul 2 (Cl20.vec x2 x1) := by
  refine ⟨rfl, ?_⟩
  unfold Cl20.negSandwich wallNormal Cl20.vec Cl20.mul Cl20.smul
  simp only [Cl20.mk.injEq]
  refine ⟨by omega, by omega, by omega, by omega⟩


/-! ## 2. `Pin(2)` Reflection Origin of `D_ret = 2` Stage-3b Cones (`A.3`, `A.8`, `A.9`, `BMO 1`) -/

def linA3Gt (p : Int × Int) : Int × Int := (p.1 - p.2, 3 * p.2)
def linA3Lt (p : Int × Int) : Int × Int := (p.2 - p.1, 3 * p.1)

def linA89Stay (p : Int × Int) : Int × Int := (3 * p.1, p.2 - p.1)
def linA89Flip (p : Int × Int) : Int × Int := (3 * p.2, p.1 - p.2)

/-- `Pin(2)` Factorization & Stage-3a Origin of `Cryptid A.3`:
    1. `linA3Gt` (`k > m`) is a Stage-3a conserved shuttle for covector `α₀ = (2, 1)`.
    2. `linA3Lt` (`k < m`) equals `linA3Gt ∘ reflectWall` identically.
    3. Symmetrizing `α₀ = (2, 1)` with `reflectWall α₀ = (1, 2)` yields `3 • (1, 1)` (Stage 3b). -/
theorem a3_pin2_reflection_factorization (k m : Int) :
    2 * (linA3Gt (k, m)).1 + (linA3Gt (k, m)).2 = 2 * k + m ∧
      linA3Lt (k, m) = linA3Gt (reflectWall (k, m)) ∧
      (2 * k + m) + (k + 2 * m) = 3 * (k + m) := by
  unfold linA3Gt linA3Lt reflectWall
  dsimp
  exact ⟨by omega, rfl, by omega⟩

/-- `Pin(2)` Factorization & Stage-3a Origin of Mirror Cousins `A.8` and `A.9`:
    1. `linA89Stay` is a Stage-3a conserved shuttle for covector `α₀ = (1, 2)`.
    2. `linA89Flip` equals `linA89Stay ∘ reflectWall` identically across the cone wall. -/
theorem a8_a9_pin2_reflection_factorization (u v : Int) :
    (linA89Stay (u, v)).1 + 2 * (linA89Stay (u, v)).2 = u + 2 * v ∧
      linA89Flip (u, v) = linA89Stay (reflectWall (u, v)) := by
  unfold linA89Stay linA89Flip reflectWall
  dsimp
  exact ⟨by omega, rfl⟩

/-- Dual Stage-3a Cone Decomposition of `BMO 1` (`T3.6`):
    Both linear halves individually conserve a positive linear functional (`3X + Y` on `X > Y`
    and `X + Y` on `X < Y`), becoming non-integrable solely across the wall `X = Y`. -/
theorem bmo1_dual_stage3a_cones (X Y : Int) :
    3 * (X - Y) + 4 * Y = 3 * X + Y ∧
      2 * X + (Y - X) = X + Y := by
  exact ⟨by omega, by omega⟩


/-! ## 3. Projective Geometric Algebra `PGA(1) = Cl(1, 0, 1)` & Ghost Eigenblades -/

/-- Multivector `s + x1 * e₁ + x0 * e₀ + b10 * (e₁ ∧ e₀)` in `PGA(1) = Cl(1, 0, 1)`,
    where `e₁² = +1` (spatial axis) and `e₀² = 0` (null projective origin). -/
structure PGA1 where
  s : Int
  x1 : Int
  x0 : Int
  b10 : Int
  deriving DecidableEq, Repr

namespace PGA1

def point (u : Int) : PGA1 := ⟨0, u, 1, 0⟩

def homPoint (u w : Int) : PGA1 := ⟨0, u, w, 0⟩

def wedge1 (a b : PGA1) : PGA1 :=
  ⟨0, 0, 0, a.x1 * b.x0 - a.x0 * b.x1⟩

def smul (k : Int) (a : PGA1) : PGA1 :=
  ⟨k * a.s, k * a.x1, k * a.x0, k * a.b10⟩

end PGA1

/-- Universal `PGA(1)` Grade-2 Ghost Eigenblade Theorem:
    For ANY affine fast-loop step `D * uNext = A * u + B` over `Int`, let `X = u e₁ + e₀`,
    `X' = uNext e₁ + e₀`, and homogeneous ghost 1-vector `G = B e₁ + (D - A) e₀`.
    Then the exterior bivector `X ∧ G` scales purely multiplicatively with zero offset:
    `D • (X' ∧ G) = A • (X ∧ G)`. -/
theorem pga1_ghost_bivector_eigenblade (A B D u uNext : Int)
    (hStep : D * uNext = A * u + B) :
    PGA1.smul D (PGA1.wedge1 (PGA1.point uNext) (PGA1.homPoint B (D - A))) =
      PGA1.smul A (PGA1.wedge1 (PGA1.point u) (PGA1.homPoint B (D - A))) := by
  unfold PGA1.smul PGA1.wedge1 PGA1.point PGA1.homPoint
  simp only [PGA1.mk.injEq, Int.mul_zero, Int.one_mul]
  refine ⟨trivial, trivial, trivial, ?_⟩
  have hL : D * (uNext * (D - A) - B) = A * u * (D - A) + (D * B - A * B) - D * B := by
    rw [Int.mul_sub, ← Int.mul_assoc D uNext (D - A), hStep, Int.add_mul,
        Int.mul_sub B D A, Int.mul_comm B D, Int.mul_comm B A]
  have hR : A * (u * (D - A) - B) = A * u * (D - A) - A * B := by
    rw [Int.mul_sub, ← Int.mul_assoc A u (D - A)]
  omega

/-- Exact `PGA(1)` Bridge Bivectors for Antihydra (`G_{-1}`, `G_0`, `G_relay`):
    - `G_{-1} ∧ G_0 = -108 (e₁ ∧ e₀) = (-2² * 27) (e₁ ∧ e₀)`,
    - `G_{-1} ∧ G_relay = -1728 (e₁ ∧ e₀) = (-2⁶ * 27) (e₁ ∧ e₀)` (exact `2⁶` ultrametric gap). -/
theorem pga1_antihydra_bridge_bivectors :
    let gDeficit := PGA1.homPoint (-57) 65
    let gNeutral := PGA1.homPoint (-15) 19
    let gRelay   := PGA1.homPoint (-1779) 2059
    (PGA1.wedge1 gDeficit gNeutral).b10 = -(2 ^ 2 * 27) ∧
      (PGA1.wedge1 gDeficit gRelay).b10 = -(2 ^ 6 * 27) := by
  decide


/-! ## 4. Inter-Dimensional Covector Intertwining & `ℤ₂` Sheet Bridges on Actual Cryptids -/

/-- `AppC_1` (`2D B → 3D E2`) Lift Bridge:
    Lifting `B(L, R)` (`L ≥ 2`) into 3D `E2(0, L - 1, R)` jumps energy by exact scalar `+2`. -/
theorem appC1_bridge_B_to_E2_jump (L R : Nat) (hL : L ≥ 2) :
    stepAppC1 (.B L R) = some (.E2 0 (L - 1) R) ∧
      energyAppC1 (.E2 0 (L - 1) R) = energyAppC1 (.B L R) + 2 := by
  refine ⟨?_, ?_⟩
  · unfold stepAppC1
    have h0 : ¬ (L = 0) := by omega
    have h1 : ¬ (L = 1) := by omega
    simp [h0, h1]
  · simp only [energyAppC1]
    omega

/-- `AppC_1` (`3D E2 → 2D E1`) Zero-Loss Compression Bridge & Ghost Handoff Unification:
    1. Compressing `E2(x, k, R)` (`k ≤ x`) to `E1(x + 1, 2k + 2 + R)` preserves `energyAppC1`
       with ZERO scalar or spatial loss (`ΔE = 0` identically).
    2. Ghost-shifted outputs of Bridge A (`2x + 4`) and Bridge B (`x + 1`) obey
       `(2x + 4) + 2 = 2 * ((x + 1) + 2)` (Bridge A equals Bridge B plus one `E1` doubling). -/
theorem appC1_bridge_E2_to_E1_zero_loss (x k R : Nat) (hk : k ≤ x) :
    stepAppC1 (.E2 x k R) = some (.E1 (x + 1) (2 * k + 2 + R)) ∧
      energyAppC1 (.E1 (x + 1) (2 * k + 2 + R)) = energyAppC1 (.E2 x k R) ∧
      (2 * x + 4) + 2 = 2 * ((x + 1) + 2) := by
  refine ⟨?_, ?_, by omega⟩
  · unfold stepAppC1
    have h1 : ¬ (k ≥ x + 2) := by omega
    have h2 : ¬ (k = x + 1) := by omega
    simp [h1, h2]
  · simp only [energyAppC1]
    omega

/-- `AppC_1` (`2D E1 → 2D B`) Even-`z` Safe-Sector Return has Exact Zero Energy Loss (`ΔE = 0`). -/
theorem appC1_bridge_E1_to_B_even_zero_loss (X z : Nat)
    (hX : X ≥ 2) (hzLo : z ≥ 2) (hzHi : z ≤ 2 * X - 1) (hzEven : z % 2 = 0) :
    energyAppC1 (.B (X - 1 - z / 2) (4 * (z / 2) + 2)) = energyAppC1 (.E1 X z) := by
  have _ := hX; have _ := hzLo; have _ := hzHi; have _ := hzEven
  simp only [energyAppC1]
  omega

/-- Helper constructing the `2D×ℤ₂` sheet state (`LC` if `true`, `LE` if `false`) of `T3.14`. -/
def mkLeftT314 (isLC : Bool) (u w : Nat) : StateT314 :=
  if isLC then StateT314.LC u w else StateT314.LE u w

/-- Helper extracting the `ℤ₂` double-cover sheet bit (`true` on `LC`, `false` on `LE`) of `T3.14`. -/
def isLCSheetT314 : StateT314 → Bool
  | .LC _ _ => true
  | .LE _ _ => false
  | _ => false

/-- `T3.14` (`2D×ℤ₂ LC/LE → 2D AB`) Exact Covector Intertwining Theorem:
    Across the shearing bridge `(u, w) ↦ (2u + 9 - 3w, 2w - 4)` (`2 ≤ w < wThr`),
    `B^T (1, 2) = (2, 1)` holds identically, producing a state-independent `+1` energy jump. -/
theorem t314_bridge_LCLE_to_AB_intertwining (isLC : Bool) (u w : Nat)
    (hu : u ≥ 1) (hwLo : w ≥ 2)
    (hwHi : w < 2 * ((u - 1) / 3) + 4 + (if (u - 1) % 3 ≥ 1 then 1 else 0)) :
    stepT314 (mkLeftT314 isLC u w) = some (.AB (2 * u + 9 - 3 * w) (2 * w - 4)) ∧
      energyT314 (.AB (2 * u + 9 - 3 * w) (2 * w - 4)) = energyT314 (mkLeftT314 isLC u w) + 1 := by
  have _ := hu
  have hw0 : ¬ (w = 0) := by omega
  have hw1 : ¬ (w = 1) := by omega
  cases isLC <;>
    (refine ⟨?_, ?_⟩
     · simp [mkLeftT314, stepT314, stepT314Left, hwHi, hw0, hw1]
     · simp [mkLeftT314, energyT314]
       by_cases hs : (u - 1) % 3 ≥ 1 <;> simp [hs] at hwHi <;> omega)

/-- `T3.14` `ℤ₂` Grade-Flip Lock Theorem:
    On every interior `×4/3` step (`w ≥ wThr`, `u ≥ 1`), `energyT314` has zero drift (`ΔE = 0`)
    if and only if `(u - 1) % 3 = 2`, in which case the step strictly flips the `LC ↔ LE` sheet! -/
theorem t314_zero_drift_iff_sheet_flip (isLC : Bool) (u w : Nat)
    (hu : u ≥ 1)
    (hw : w ≥ 2 * ((u - 1) / 3) + 4 + (if (u - 1) % 3 ≥ 1 then 1 else 0)) :
    (energyT314 (stepT314Left isLC u w) = energyT314 (mkLeftT314 isLC u w) ↔ (u - 1) % 3 = 2) ∧
      ((u - 1) % 3 = 2 → isLCSheetT314 (stepT314Left isLC u w) = !isLCSheetT314 (mkLeftT314 isLC u w)) := by
  have _ := hu
  cases isLC <;>
    (if hs0 : (u - 1) % 3 = 0 then
       have hGe : ¬ ((u - 1) % 3 ≥ 1) := by omega
       simp [hs0, hGe] at hw
       have hNotLt : ¬ (w < 2 * ((u - 1) / 3) + 4) := by omega
       simp [mkLeftT314, stepT314Left, energyT314, isLCSheetT314, hs0, hGe, hNotLt]
       omega
     else if hs1 : (u - 1) % 3 = 1 then
       have hGe : (u - 1) % 3 ≥ 1 := by omega
       simp [hs1, hGe] at hw
       have hNotLt : ¬ (w < 2 * ((u - 1) / 3) + 4 + 1) := by omega
       simp [mkLeftT314, stepT314Left, energyT314, isLCSheetT314, hs0, hs1, hGe, hNotLt]
       omega
     else
       have hs2 : (u - 1) % 3 = 2 := by omega
       have hGe : (u - 1) % 3 ≥ 1 := by omega
       simp [hs2, hGe] at hw
       have hNotLt : ¬ (w < 2 * ((u - 1) / 3) + 4 + 1) := by omega
       simp [mkLeftT314, stepT314Left, energyT314, isLCSheetT314, hs0, hs1, hs2, hGe, hNotLt]
       omega)

/-- `T3.12` (`2D R → 2D C`) Zero-Loss Return Bridge (`1 ≤ u ≤ w`):
    `R(u, w) → C(2u - 1, 2(w + 1 - u))` intertwines `(2, 2) ↔ (2, 1)` with `ΔE = 0` exact. -/
theorem t312_bridge_R_to_C_zero_loss (u w : Nat) (hu : u ≥ 1) (huw : u ≤ w) :
    stepT312 (.R u w) = some (.C (2 * u - 1) (2 * (w + 1 - u))) ∧
      energyT312 (.C (2 * u - 1) (2 * (w + 1 - u))) = energyT312 (.R u w) := by
  refine ⟨?_, ?_⟩
  · unfold stepT312
    have h1 : ¬ (u > w) := by omega
    have h2 : ¬ (u = 0) := by omega
    simp [h1, h2]
  · simp only [energyT312]
    omega

/-- `Cryptid A.5` (`3D D → 2D C`) Exact Boundary Return Bridge (`da = 0`, `du` odd):
    Compressing 3D `D(0, 2q + 1, dw)` onto 2D `C(q + 1, dw)` jumps energy by exact scalar `+1`. -/
theorem a5_bridge_D_to_C_da0_jump (q dw : Nat) (hdw : dw ≥ 1) :
    stepA5 (.D 0 (2 * q + 1) dw) = some (.C (q + 1) dw) ∧
      energyA5 (.C (q + 1) dw) = energyA5 (.D 0 (2 * q + 1) dw) + 1 := by
  have _ := hdw
  refine ⟨?_, ?_⟩
  · unfold stepA5
    have h1 : ¬ (dw ≥ 3 ∧ 0 ≥ 1) := by omega
    have hDiv : (2 * q + 1 + 1) / 2 = q + 1 := by omega
    simp [h1, hDiv]
  · simp only [energyA5]
    omega

/-- `Cryptid A.1` Plücker Bivector Annihilation & 3-Blade Swap Reflection Bridge:
    1. Every reachable state from blank-tape entry `⟨0, 0, 1, 3⟩` satisfies `b * c = 0`
       (the `e_b ∧ e_c` 2-blade vanishes identically).
    2. On the 2D bridge intersection `a = 0, c = 0, d ≥ 2`, `stepA1` reflects the `b`-blade
       onto the `c`-blade (`c' = b + 2, d' = d - 2`) with exact `+2` raw covector jump. -/
theorem a1_plucker_blade_and_swap_bridge (n : Nat) (s : StateA1)
    (hReach : iterStep stepA1 n ⟨0, 0, 1, 3⟩ = some s) :
    s.b * s.c = 0 := by
  have hInv : InvA1 s := iterStep_invariant stepA1 InvA1 invA1_preserved n _ s invA1_init hReach
  unfold InvA1 at hInv
  cases hInv with
  | inl hb0 => rw [hb0, Nat.zero_mul]
  | inr hc0 => rw [hc0, Nat.mul_zero]

theorem a1_blade_swap_reflection_step (b d : Nat) (hd : d ≥ 2) :
    stepA1 ⟨0, b, 0, d⟩ = some ⟨0, 0, b + 2, d - 2⟩ ∧
      0 + 2 * 0 + 2 * (b + 2) + (d - 2) = (0 + 2 * b + 2 * 0 + d) + 2 := by
  refine ⟨?_, by omega⟩
  unfold stepA1
  dsimp
  have hd0 : ¬ (d = 0) := by omega
  have hd1 : ¬ (d = 1) := by omega
  simp [hd0, hd1]

end CryptidSolve
